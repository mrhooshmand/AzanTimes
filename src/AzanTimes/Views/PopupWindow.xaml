<Window x:Class="AzanTimes.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AzanTimes"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        Cursor="Hand"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Margin="16"
            Width="340"
            CornerRadius="12"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.18" Color="#101828" />
        </Border.Effect>
        <StackPanel>
            <Border Height="4" Background="#0F6CBD" CornerRadius="12,12,0,0" />
            <StackPanel Margin="22,16,22,20" FlowDirection="RightToLeft">
                <TextBlock Text="AzanTimes" Foreground="#0F6CBD" FontSize="12" FontWeight="SemiBold" />
                <Border x:Name="SampleText"
                        HorizontalAlignment="Right"
                        Background="#F3F4F6"
                        CornerRadius="10"
                        Padding="8,2"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <TextBlock Text="نمایش آزمایشی" Foreground="#4B5563" FontSize="12" />
                </Border>
                <TextBlock x:Name="TitleText"
                           Foreground="#1F2328"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0" />
                <TextBlock x:Name="TimeText"
                           Foreground="#0F6CBD"
                           FontSize="40"
                           FontWeight="SemiBold"
                           Margin="0,2,0,0" />
                <TextBlock x:Name="DetailText"
                           Foreground="#656D76"
                           FontSize="14"
                           Margin="0,6,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
