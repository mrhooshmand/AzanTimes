<Window x:Class="AzanTimes.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AzanTimes"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Border x:Name="Card"
            Margin="16"
            Width="304"
            CornerRadius="12"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.16" Color="#101828" />
        </Border.Effect>
        <StackPanel>
            <DockPanel LastChildFill="True" FlowDirection="LeftToRight" Margin="14,12,14,0">
                <Button DockPanel.Dock="Left"
                        Width="28"
                        Height="28"
                        Margin="0,2,8,0"
                        VerticalAlignment="Top"
                        ToolTip="پنهان کردن"
                        Click="Hide_Click"
                        Cursor="Hand"
                        Foreground="#656D76"
                        FontSize="16">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#F3F4F6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    ×
                </Button>
                <StackPanel FlowDirection="RightToLeft">
                    <TextBlock Text="AzanTimes" Foreground="#0F6CBD" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="اوقات شرعی" Foreground="#1F2328" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0" />
                    <TextBlock x:Name="CityDateText" Foreground="#656D76" FontSize="13" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
            <StackPanel x:Name="TimesPanel" Margin="10,12,10,4" FlowDirection="RightToLeft" />
            <Border Background="#F8FAFC"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="14,4,14,14">
                <TextBlock x:Name="NextText"
                           Foreground="#0F6CBD"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           FlowDirection="RightToLeft" />
            </Border>
        </StackPanel>
    </Border>
</Window>
